{
  "name": "vibecheck",
  "displayName": "VibeCheck",
  "description": "AI Security Companion",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.135.0"
  },
  "categories": [ 
    "Other"
  ],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vibecheck.scan",
        "title": "VibeCheck: Scan codebase"
      },
      {
        "command": "vibecheck.acceptFix",
        "title": "VibeCheck: Accept fix",
        "icon": {
          "light": "media/accept-icon.svg",
          "dark": "media/accept-icon.svg"
        }
      },
      {
        "command": "vibecheck.rejectFix",
        "title": "VibeCheck: Reject fix",
        "icon": {
          "light": "media/reject-icon.svg",
          "dark": "media/reject-icon.svg"
        }
      },
      {
        "command": "vibecheck.fixCurrentFile",
        "title": "VibeCheck: Fix current file with Gemini"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "vibecheck.acceptFix",
          "when": "vibecheck.fixDiffActive",
          "group": "navigation@1"
        },
        {
          "command": "vibecheck.rejectFix",
          "when": "vibecheck.fixDiffActive",
          "group": "navigation@2"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "vibecheck",
          "title": "VibeCheck",
          "icon": "media/vibecheck.svg"
        }
      ]
    },
    "views": { 
      "vibecheck": [
        {
          "type": "webview",
          "id": "vibecheck.sidebar",
          "name": "VibeCheck",
          "icon": "media/vibecheck.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.135.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}